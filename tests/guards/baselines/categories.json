{
  "family": "categories",
  "unmigrated": [
    "src/app/(app)/categories/[id]/edit/page.tsx",
    "src/app/(app)/categories/[id]/page.tsx",
    "src/app/(app)/categories/new/page.tsx",
    "src/app/(app)/categories/page.tsx"
  ],
  "chrome": {
    "src/app/(app)/categories/[id]/edit/page.tsx": {
      "suspense-null": 1
    },
    "src/app/(app)/categories/[id]/page.tsx": {
      "title-prop": 1
    },
    "src/app/(app)/categories/_components/category-form.tsx": {
      "max-w-xl": 2,
      "sab-pad": 1,
      "return-to": 1
    },
    "src/app/(app)/categories/_components/category-management.tsx": {
      "min-h": 1
    },
    "src/app/(app)/categories/new/page.tsx": {
      "suspense-null": 1
    }
  }
}
