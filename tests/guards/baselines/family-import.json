{
  "family": "family-import",
  "unmigrated": [
    "src/app/(app)/import/page.tsx",
    "src/app/(app)/import/pending/page.tsx",
    "src/app/(app)/manage-accounts/page.tsx"
  ],
  "chrome": {
    "src/app/(app)/family/_components/overview-tab.tsx": {
      "backdrop-blur": 1
    },
    "src/app/(app)/import/page.tsx": {
      "title-prop": 4,
      "subtitle-prop": 1,
      "suspense-null": 1
    },
    "src/app/(app)/import/pending/_components/reconcile-header.tsx": {
      "title-prop": 1
    },
    "src/app/(app)/import/pending/_components/staged-list-view.tsx": {
      "title-prop": 2,
      "subtitle-prop": 1
    },
    "src/app/(app)/import/pending/page.tsx": {
      "suspense-null": 1
    }
  }
}
